{$DEMO_HOSTNAME} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	encode zstd gzip
	route {
		request_header -X-Kliks-Admin-Token
		@admin path /admin /admin/* /api/admin /api/admin/*
		handle @admin {
			route {
				@disabled expression `{env.DEMO_ADMIN_ENABLED} != "1" || {env.DEMO_ADMIN_TOKEN} == ""`
				respond @disabled "Administrator access is disabled." 404
				@cross_site header Sec-Fetch-Site cross-site
				respond @cross_site 403
				@foreign_origin expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "https://" + {env.DEMO_HOSTNAME}`
				respond @foreign_origin 403
				basic_auth bcrypt "KLIKS administrators" {
					{$DEMO_ADMIN_USER} {$DEMO_ADMIN_PASSWORD_HASH}
				}
				reverse_proxy web:3000 {
					header_up X-Kliks-Admin-Token {$DEMO_ADMIN_TOKEN}
				}
			}
		}
		handle {
			basic_auth {
				{$DEMO_USER} {$DEMO_PASSWORD_HASH}
				{$DEMO_ADMIN_USER} {$DEMO_ADMIN_PASSWORD_HASH}
			}
			reverse_proxy web:3000
		}
	}
}

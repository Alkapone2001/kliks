generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                      @id @default(uuid()) @db.Uuid
  phoneNumber         String                      @unique @map("phone_number") @db.VarChar(16)
  username            String                      @unique @db.VarChar(30)
  phoneVerifiedAt     DateTime?                   @map("phone_verified_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  verificationChallenges PhoneVerificationChallenge[]

  @@map("users")
}

model PhoneVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.VarChar(128)
  salt       String    @db.VarChar(32)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("phone_verification_challenges")
}
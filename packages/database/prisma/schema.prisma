generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum LinkedBankAccountStatus {
  PENDING_AUTHORIZATION
  CONNECTED
  REJECTED
  DISCONNECTED
}

enum PaymentState {
  CREATED
  REQUIRES_AUTHORIZATION
  PROCESSING
  SUCCEEDED
  REJECTED
  FAILED
  CANCELLED
}

enum PaymentRequestState {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id                  String                      @id @default(uuid()) @db.Uuid
  phoneNumber         String                      @unique @map("phone_number") @db.VarChar(16)
  username            String                      @unique @db.VarChar(30)
  phoneVerifiedAt     DateTime?                   @map("phone_verified_at")
  directoryListingEnabled Boolean                  @default(false) @map("directory_listing_enabled")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  verificationChallenges PhoneVerificationChallenge[]
  linkedBankAccounts     LinkedBankAccount[]
  paymentsInitiated      Payment[]                   @relation("PaymentsAsPayer")
  paymentsReceived       Payment[]                   @relation("PaymentsAsPayee")
  requestsCreated        PaymentRequest[]            @relation("RequestCreator")
  requestsReceived       PaymentRequest[]            @relation("RequestPayer")
  qrPaymentSessions      QrPaymentSession[]

  @@map("users")
}

model PhoneVerificationChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.VarChar(128)
  salt       String    @db.VarChar(32)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("phone_verification_challenges")
}

model LinkedBankAccount {
  id                         String                  @id @default(uuid()) @db.Uuid
  userId                     String                  @map("user_id") @db.Uuid
  connectorId                String                  @map("connector_id") @db.VarChar(40)
  providerAccountReference   String                  @unique @map("provider_account_reference") @db.VarChar(100)
  displayName                String                  @map("display_name") @db.VarChar(80)
  connectionStatus           LinkedBankAccountStatus @default(PENDING_AUTHORIZATION) @map("connection_status")
  isDefault                  Boolean                 @default(false) @map("is_default")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  user                       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentsAsPayer            Payment[]                @relation("PaymentPayerAccount")
  paymentsAsPayee            Payment[]                @relation("PaymentPayeeAccount")

  @@index([userId, connectionStatus])
  @@index([userId, createdAt])
  @@map("linked_bank_accounts")
}

model AuditEventRecord {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json

  @@index([entityId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("audit_events")
}

model Payment {
  id                     String              @id @default(uuid()) @db.Uuid
  payerId                String              @map("payer_id") @db.Uuid
  payeeId                String              @map("payee_id") @db.Uuid
  payerAccountId         String              @map("payer_account_id") @db.Uuid
  payeeAccountId         String              @map("payee_account_id") @db.Uuid
  idempotencyKey         String              @map("idempotency_key") @db.VarChar(128)
  requestFingerprint     String              @map("request_fingerprint") @db.Char(64)
  amountMinor            BigInt              @map("amount_minor") @db.BigInt
  currency               String              @db.Char(3)
  state                  PaymentState        @default(CREATED)
  providerReference      String?             @unique @map("provider_reference") @db.VarChar(100)
  failureCode            String?             @map("failure_code") @db.VarChar(40)
  simulation             Boolean             @default(true)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  payer                  User                @relation("PaymentsAsPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payee                  User                @relation("PaymentsAsPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  payerAccount           LinkedBankAccount   @relation("PaymentPayerAccount", fields: [payerAccountId], references: [id], onDelete: Restrict)
  payeeAccount           LinkedBankAccount   @relation("PaymentPayeeAccount", fields: [payeeAccountId], references: [id], onDelete: Restrict)
  paymentRequest         PaymentRequest?
  qrPaymentSession       QrPaymentSession?

  @@unique([payerId, idempotencyKey])
  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@map("payments")
}

model PaymentRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  requesterId        String              @map("requester_id") @db.Uuid
  payerId            String              @map("payer_id") @db.Uuid
  amountMinor        BigInt              @map("amount_minor") @db.BigInt
  currency           String              @db.Char(3)
  state              PaymentRequestState @default(PENDING)
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(128)
  paymentId          String?             @unique @map("payment_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  requester          User                @relation("RequestCreator", fields: [requesterId], references: [id], onDelete: Restrict)
  payer              User                @relation("RequestPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payment            Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, createdAt])
  @@index([payerId, createdAt])
  @@map("payment_requests")
}

model QrPaymentSession {
  id                 String    @id @default(uuid()) @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  amountMinor        BigInt?   @map("amount_minor") @db.BigInt
  currency           String    @db.Char(3)
  idempotencyKey     String    @map("idempotency_key") @db.VarChar(128)
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  paymentId          String?   @unique @map("payment_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  payment            Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("qr_payment_sessions")
}